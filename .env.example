# PostgreSQL. Supabase: use the connection string from Project Settings > Database.
# Prisma-style URLs work as-is (postgresql://...?sslmode=require).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview_monitoring"

# Signs session tokens (min 32 chars). Generate with: openssl rand -base64 48
# Use the SAME value as the old backend if you want existing sessions to survive the switch.
JWT_SECRET=""

# Must match your LiveKit server / LiveKit Cloud project.
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret-devsecret-devsecret-dev"
# Address this backend uses to reach the LiveKit API.
LIVEKIT_HOST="http://localhost:7880"
# Address phones and browsers use to connect (a phone needs your LAN IP or a public wss:// URL).
LIVEKIT_PUBLIC_URL="ws://localhost:7880"
LIVEKIT_TOKEN_TTL_SECONDS=600

# Readiness score (0-100) a candidate must reach to finish calibration.
READINESS_THRESHOLD=80

# Optional. Registering with this code creates an ADMIN. Leave empty to disable.
ADMIN_REGISTRATION_CODE=""

# development | production. Production turns on Secure cookies.
ENVIRONMENT=development

# --- Separate deployment (frontend and API on different domains) ---------------------
# Comma-separated browser origins allowed to call the API with cookies. Leave empty when the
# dashboard proxies /api/* (same-origin) or only uses Bearer tokens from non-browser clients.
CORS_ORIGINS=""
# lax (same site) | none (frontend on a different site; forces Secure, needs https)
COOKIE_SAMESITE=lax
# Optional, e.g. ".example.com" to share the cookie between app.example.com and api.example.com.
COOKIE_DOMAIN=""

# Interactive docs at /docs and /redoc. Set false to hide them in production.
DOCS_ENABLED=true

# --- AI screen detection agent (vision model; Azure OpenAI v1 / OpenAI-compatible) ------
OPENAI_SIX_LUNA_API_KEY=""
OPENAI_SIX_LUNA_BASE_URL="https://<resource>.openai.azure.com/openai/v1"
OPENAI_SIX_LUNA_MODEL="<deployment name>"
# Optional: request timeout, and extra apps that always raise HIGH (comma-separated).
SCREEN_AGENT_TIMEOUT_SECONDS=30
SCREEN_AGENT_HIGH_APPS=""

# --- Interview recordings (Azure Blob Storage) ---------------------------------------
AZURE_STORAGE_ENDPOINT="https://<account>.blob.core.windows.net/"
AZURE_STORAGE_SAS_TOKEN=""   # needs read/write/create/list/delete on blobs
# Lowercase letters, digits, hyphens only (Azure rejects underscores/capitals).
AZURE_VIDEO_CONTAINER="interview-videos"
AZURE_IMAGE_CONTAINER="interviews-images"   # screenshots of HIGH screen alerts

# ------------------------------------------------------------------------------------------------
# Razorpay one-time payment (see app/subscription/plans.py for price, days and interviews)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# false = anyone can create interviews (useful for local development)
SUBSCRIPTION_ENFORCED=true

# Email sent to users after payment (Google Workspace: use an app password)
EMAIL_SENDER_C=info@speedychat.io
EMAIL_PASSWORD_C=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER_NAME=Interview Detect
APP_URL=https://speedychat.io
